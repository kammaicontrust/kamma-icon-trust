rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read gallery, allow authenticated users to write (assuming admins are authenticated)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow users to upload and manage their own resumes and profile images
    match /resumes/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
