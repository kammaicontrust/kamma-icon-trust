rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is from an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kammaicontrust@gmail.com';
    }
    
    // ─── Registrations Collection (Single Source of Truth) ───
    // Public read: Needed for directory listing and token verification gate
    // Owner write: Only the user themselves can update their profile
    // Admin write: Admin can approve, reject, hide, update or delete any profile
    match /registrations/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // ─── Gallery Collection ───
    // Public read, authenticated admin write
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Videos Collection ───
    // Public read, authenticated admin write
    match /videos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Default Deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
