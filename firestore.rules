rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Registrations Collection (Single Source of Truth) ───
    // Public read: Needed for directory listing and token verification gate
    // Owner write: Only the user themselves can update their profile
    match /registrations/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    


    // ─── Gallery Collection ───
    // Public read, authenticated write (admin uploads)
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Videos Collection ───
    // Public read, authenticated write (admin uploads)
    match /videos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Default Deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
