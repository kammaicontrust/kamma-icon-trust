rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── Users Collection ───
    // Any authenticated user can read (needed for mobile/token duplicate checks)
    // Only the document owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ─── Registrations Collection (Single Source of Truth) ───
    match /registrations/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    


    // ─── Gallery Collection ───
    // Public read, authenticated write (admin uploads)
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Videos Collection ───
    // Public read, authenticated write (admin uploads)
    match /videos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Default Deny ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
